# MongoDB Atlas → Connect → Drivers → copy the connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=shop
PORT=3001

# Long random string used to sign login tokens (e.g. run: openssl rand -hex 32)
SESSION_SECRET=change-me

# Set to 1 when hosted behind a proxy (Render, Railway, Cloudflare…) so rate limits see the real IP
# TRUST_PROXY=1

# Optional bot check on login — Cloudflare Turnstile (free): dash.cloudflare.com → Turnstile → Add site
# VITE_TURNSTILE_SITE_KEY=0x4AAAA...
# TURNSTILE_SECRET=0x4AAAA...

# When the site is hosted on Cloudflare Pages and the API on Render:
#   on Render:            ALLOWED_ORIGINS=https://your-site.pages.dev
#   on Cloudflare Pages:  VITE_API_URL=https://your-api.onrender.com
# ALLOWED_ORIGINS=
# VITE_API_URL=

# Only these Twitter names can open the dashboard, and they must also enter ADMIN_PASSWORD
ADMIN_USERNAMES=
ADMIN_PASSWORD=

# Shop Twitter account customers DM after reserving (Cloudflare Pages). Defaults to OoKamaruvvoO
# VITE_SHOP_TWITTER=

# Seasonal theme on Cloudflare Pages: christmas (default) or default
# VITE_THEME=
